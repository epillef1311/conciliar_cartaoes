VELO_LOGIN_URL=https://app.cicalesesolucoes.com.br/
VELO_LOGIN_ENDPOINT=/login/auth
VELO_USUARIO=usuario_de_teste
VELO_SENHA=senha_de_teste
VELO_SESSION_VALIDATE_ENDPOINT=/session/validate
VELO_MANUAL_LOGIN_TIMEOUT_SECONDS=300
VELO_CDP_ENDPOINT=http://127.0.0.1:9222
VELO_STORAGE_STATE_FILE=output/storage_state.json
VELO_PROFILE_DIR=output/chrome_profile
VELO_TRACE_FILE=output/capture_trace.zip
VELO_ERROR_SCREENSHOT=output/capture_error.png
VELO_API_BASE_URL=https://api.v1.velosistema.com.br
VELO_VALIDATE_TOKEN_ENDPOINT=/session/validate-token
VELO_VALIDATE_TOKEN_METHOD=GET
VELO_AUTH_HEADER=Authorization
VELO_AUTH_SCHEME=Bearer
VELO_TOKEN_FILE=output/token.txt
VELO_HTTP_TIMEOUT=30
